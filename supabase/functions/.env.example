# ============================================================
# SLine Edge Functions — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file (it is gitignored).
# ============================================================

# --- Supabase Core ---
# Auto-injected when deployed to Supabase hosted platform.
# Required for local development with `supabase functions serve`.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- QiCard Payment Gateway ---
# Required for all payment flows (booking, tender, direct offer).
QICARD_API_BASE_URL=https://api.qicard.com
QICARD_TERMINAL_ID=your-terminal-id
QICARD_USERNAME=your-username
QICARD_PASSWORD=your-password
QICARD_RSA_PUBLIC_KEY_PEM=your-rsa-public-key-pem
QICARD_FINISH_URL=https://your-app.com/payment/finish
QICARD_PROVIDER_NAME=QiCard
QICARD_NOTIFICATION_URL=https://your-project.supabase.co/functions/v1/qicard_webhook_handler

# Optional: Allow unsigned requests in local development (default: false)
QICARD_ALLOW_UNSIGNED_LOCAL_DEV=false

# --- Push Notifications ---
# Required for FCM push notification delivery.
FCM_SERVER_KEY=your-fcm-server-key

# --- Cron & Internal Security ---
# Secrets used to authenticate scheduled function calls and internal push routes.
CRON_SECRET=your-cron-secret
PUSH_NOTIFY_SECRET=your-push-notify-secret

# --- App Configuration ---
# CORS allowed origin for Edge Function responses.
ALLOWED_ORIGIN=https://sline.app

# Optional: Runtime environment identifier (default: production)
ENVIRONMENT=production

# Optional: Payment expiry window in minutes (default: 30)
BOOKING_PAYMENT_EXPIRY_MINUTES=30
